{
  "name": "steam-manager",
  "version": "0.1.0",
  "description": "Add games from other launchers to Steam as non-Steam shortcuts, with tags and SteamGridDB artwork",
  "type": "module",
  "bin": {
    "steam-manager": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
