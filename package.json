{
  "name": "steam-manager",
  "version": "0.1.0",
  "description": "Add games from other launchers to Steam as non-Steam shortcuts, with tags and SteamGridDB artwork",
  "type": "module",
  "bin": {
    "steam-manager": "dist/src/bin.js"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ui:build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start": "npm run build && npm run ui:build && electron .",
    "dev": "npm run build && concurrently -k -n ui,app \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "ui:dev": "vite"
  },
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "commander": "^15.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "dist/electron/main.js"
}
